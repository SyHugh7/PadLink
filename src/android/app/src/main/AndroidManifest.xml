<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Dhizuku：API 权限，以及 Android 11+ 能发现 Dhizuku 服务器的 queries。 -->
    <uses-permission android:name="com.rosan.dhizuku.permission.API" />

    <queries>
        <package android:name="com.rosan.dhizuku" />
        <provider android:authorities="com.rosan.dhizuku.server.provider" />
        <intent>
            <action android:name="com.rosan.dhizuku.server.provider" />
        </intent>
        <intent>
            <action android:name="com.rosan.dhizuku.action.request.permission" />
        </intent>
    </queries>

    <application
        android:name=".PadLinkApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PadLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode|locale|layoutDirection"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PadLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode|locale|layoutDirection"
            android:label="设置"
            android:theme="@style/Theme.PadLink" />
    </application>

</manifest>
